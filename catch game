import java.awt.*;
import java.awt.event.*;
import java.util.Random;
import javax.swing.*;

public class CatchGame extends JPanel implements ActionListener, KeyListener {

    private int basketX = 150;
    private int objectX = 100;
    private int objectY = 0;

    private int score = 0;
    private int misses = 0;

    private final Timer timer;
    private final Random rand = new Random();

    /**
     * 
     */
    public CatchGame() {
        setPreferredSize(new Dimension(400, 400));
        setBackground(Color.BLACK);
        setFocusable(true);
        addKeyListener(this);

        timer = new Timer(20, this);
        timer.start();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        // Draw basket
        g.setColor(Color.GREEN);
        g.fillRect(basketX, 350, 80, 20);

        // Draw falling object
        g.setColor(Color.RED);
        g.fillOval(objectX, objectY, 20, 20);

        // Draw score
        g.setColor(Color.WHITE);
        g.drawString("Score: " + score, 10, 20);
        g.drawString("Misses: " + misses, 10, 40);
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        objectY += 5;

        // Check catch
        if (objectY >= 330 &&
            objectX >= basketX &&
            objectX <= basketX + 80) {

            score++;
            resetObject();
        }

        // Missed
        if (objectY > 400) {
            misses++;
            resetObject();
        }

        // Game over
        if (misses >= 5) {
            timer.stop();
            JOptionPane.showMessageDialog(this, "Game Over! Score: " + score);
            System.exit(0);
        }

        repaint();
    }

    private void resetObject() {
        objectY = 0;
        objectX = rand.nextInt(380);
    }

    @Override
    public void keyPressed(KeyEvent e) {
        int key = e.getKeyCode();

        if (key == KeyEvent.VK_LEFT && basketX > 0) {
            basketX -= 20;
        }
        if (key == KeyEvent.VK_RIGHT && basketX < 320) {
            basketX += 20;
        }
    }

    @Override public void keyReleased(KeyEvent e) {}
    @Override public void keyTyped(KeyEvent e) {}

    public static void main(String[] args) {
        JFrame frame = new JFrame("Catch Game");
        CatchGame game = new CatchGame();

        frame.add(game);
        frame.pack();
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
}
